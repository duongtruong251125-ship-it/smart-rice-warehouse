rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(currentUserPath())
        && get(currentUserPath()).data.isActive == true;
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(currentUserPath()).data.role == 'admin';
    }

    function isStaffOrAdmin() {
      return hasActiveProfile()
        && get(currentUserPath()).data.role in ['admin', 'staff'];
    }

    function hasOnlyUserFields() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'role',
        'isActive',
        'createdAt',
        'updatedAt',
        'avatarPath'
      ]);
    }

    function hasValidUserData() {
      return hasOnlyUserFields()
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.role in ['admin', 'staff']
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // A newly registered account can only create a disabled staff profile.
      // An administrator must activate it before business data is accessible.
      allow create: if hasValidUserData() && (
        isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'staff'
          && request.resource.data.isActive == false
        )
      );

      // Cập nhật hồ sơ:
      // 1. Quản trị viên (admin) có toàn quyền cập nhật hoặc phân quyền tài khoản
      // 2. Người dùng chỉ được phép đổi tên hiển thị (displayName) và thời gian cập nhật của chính mình;
      //    tuyệt đối KHÔNG ĐƯỢC PHÉP và KHÔNG THỂ thay đổi chức vụ (role), email hoặc trạng thái kích hoạt (isActive).
      allow update: if (
        isAdmin() && hasValidUserData()
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
      ) || (
        hasActiveProfile()
        && request.auth.uid == userId
        && hasValidUserData()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
      );
      allow delete: if isAdmin();
    }

    match /rice_products/{documentId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /rice_characteristics/{documentId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /suppliers/{documentId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /customers/{documentId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /warehouse_locations/{documentId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    match /batches/{documentId} {
      allow read: if isStaffOrAdmin();
      // Stock and lot identity are server-owned. A location move is not a
      // stock transaction and may update only these display/location fields.
      allow create, delete: if false;
      allow update: if isStaffOrAdmin()
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'warehouseLocationId', 'locationName', 'locationNameSnapshot', 'updatedAt'
        ])
        && request.resource.data.warehouseLocationId is string
        && request.resource.data.locationName is string
        && request.resource.data.updatedAt is timestamp
        && get(/databases/$(database)/documents/warehouse_locations/$(request.resource.data.warehouseLocationId)).data.isActive == true;
    }

    match /import_receipts/{documentId} {
      allow read: if isStaffOrAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /export_receipts/{documentId} {
      allow read: if isStaffOrAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /damage_reports/{documentId} {
      allow read: if isStaffOrAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /inventory_checks/{documentId} {
      allow read: if isStaffOrAdmin();
      allow create, update, delete: if false;
    }

    match /inventory_snapshots/{documentId} {
      allow read: if isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    match /stock_movements/{documentId} {
      allow read: if isStaffOrAdmin();
      allow create: if false;
      // Immutable audit ledger: never allow update or delete
      allow update, delete: if false;
    }

    match /migration_runs/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /batch_codes/{documentId} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
    }

    // Deny collections that are not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
